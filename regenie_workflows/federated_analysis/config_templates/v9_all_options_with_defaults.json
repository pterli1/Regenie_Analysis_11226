    "irrelevant_covar1",
    "irrelevant_covar2"
  ],
  "exclude_covars_dict": {
    "1": [
      "covar_to_exclude_on_chr1",
      "these_covars_are_excluded_in_addition_to_pgs_covars",
      "covar3"
    ],
    "6": [
      "allows_abitrary_covars_excluded_per_chromosome",
      "covar5"
    ]
